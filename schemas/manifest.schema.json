{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAW Plugin Repository Manifest",
  "type": "object",
  "required": ["name", "id", "version", "manifestVersion", "runtime", "providers"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "manifestVersion": {"const": 1},
    "description": {"type": "string"},
    "app": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "minimumVersion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["engine", "apiVersion", "entrypoint", "callArguments", "requestContext"],
      "properties": {
        "engine": {"const": "QuickJS"},
        "apiVersion": {"type": "integer", "minimum": 1},
        "entrypoint": {"const": "getStreams"},
        "callArguments": {"const": ["tmdbId", "mediaType", "season", "episode"]},
        "requestContext": {"const": "globalThis.__CALL_ARGS__"}
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "author", "supportedTypes", "filename", "enabled", "formats"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "author": {"type": "string"},
          "supportedTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["movie", "tv"]}
          },
          "filename": {"type": "string", "pattern": "^providers/[A-Za-z0-9._-]+\\.js$"},
          "enabled": {"type": "boolean"},
          "hasSettings": {"type": "boolean"},
          "formats": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["m3u8", "mpd", "mp4", "mkv"]}
          },
          "contentLanguage": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "permissions": {
            "type": "object",
            "properties": {
              "network": {"type": "array", "items": {"type": "string"}},
              "storage": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
