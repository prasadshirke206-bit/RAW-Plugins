{
  "name": "RAW-Plugins",
  "id": "raw-plugins",
  "version": "1.0.0",
  "manifestVersion": 1,
  "description": "Official streaming provider plugins for RAW.",
  "app": {
    "id": "com.unfilteredraw.app",
    "minimumVersion": "1.0.0"
  },
  "runtime": {
    "engine": "QuickJS",
    "apiVersion": 1,
    "entrypoint": "getStreams",
    "callArguments": [
      "tmdbId",
      "mediaType",
      "season",
      "episode"
    ],
    "requestContext": "globalThis.__CALL_ARGS__"
  },
  "providers": [
    {
      "id": "raw-provider-template",
      "name": "RAW Provider Template",
      "description": "Disabled starter template. Not a production streaming provider.",
      "version": "0.1.0",
      "author": "RAW",
      "supportedTypes": ["movie", "tv"],
      "filename": "providers/provider-template.js",
      "enabled": false,
      "hasSettings": false,
      "formats": ["m3u8", "mpd", "mp4", "mkv"],
      "contentLanguage": [],
      "permissions": {
        "network": [],
        "storage": false
      }
    }
  ]
}
